    "attack_class": {
      "const": "ordinary-collision"
    },
    "rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 80
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_log2",
        "time_unit",
        "memory_log2_bytes",
        "preprocessing_log2",
        "success_probability",
        "nonuniform_advice_log2_bytes"
      ],
      "properties": {
        "time_log2": {
          "type": "number",
          "minimum": 0
        },
        "time_unit": {
          "const": "target-compressions"
        },
        "memory_log2_bytes": {
          "type": "number",
          "minimum": 0
        },
        "data_log2": {
          "type": "number",
          "minimum": 0,
          "description": "Optional legacy metadata. Not a scored or reviewed resource bound; new claims should omit it."
        },
        "preprocessing_log2": {
          "type": "number",
          "minimum": 0
        },
        "success_probability": {
          "type": "number",
          "minimum": 0.39,
          "maximum": 1
        },
        "nonuniform_advice_log2_bytes": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "restrictions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "baseline_improved": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "certificate_manifest": {
      "const": "certificates/manifest.json"
    },
    "submission_state": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "lane": {
      "enum": [
        "exploratory",
        "rigorous"
      ]
    },
    "experiment_manifest": {
      "const": "experiments/manifest.json"
    },
    "heuristics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "role",
          "scope",
          "extrapolation",
          "evidence_ids",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "role": {
            "enum": [
              "score-critical",
              "supporting"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "extrapolation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^(experiment:[A-Za-z0-9][A-Za-z0-9._-]{0,63}|proof:[1-9][0-9]*(-[1-9][0-9]*)?)$"
            }
          },
          "limitations": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    }
  },
  "description": "Fixed selected lane, target and resource model. Heuristic evidence references must resolve to declared experiments or existing proof lines; substantive adequacy is assessed by both policies."
